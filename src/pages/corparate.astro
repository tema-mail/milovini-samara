---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import ListCards from '../components/ListCards.astro';
import Steps from '../components/Steps.astro';
import FeatureList from '../components/FeatureList.astro';
import PinkCta from '../components/PinkCta.astro';
import Split from '../components/Split.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import ContactCard from '../components/ContactCard.astro';
import CorpForm from '../islands/CorpForm';
import { img } from '../lib/img';
import faq from '../data/faq.json';
const T = 'https://static.tildacdn.com/';
---
<Base title="Цветы для компаний и организаций в Самаре – Milovini Flowers" description="Корпоративные заказы цветов в Самаре: букеты для сотрудников, клиентов и партнёров, заказы к праздникам и доставка по нескольким адресам. Фото перед отправкой, доставка 24/7.">
  <PageHero
    crumbs={[{ label: 'Главная', href: '/' }, { label: 'Корпоративным клиентам' }]}
    title="Цветы для компаний и организаций в Самаре"
    text={'Milovini работает с организациями и открыта к новым корпоративным клиентам. У компании уже есть действующие договоры с организациями.\nПодберём цветы под задачу вашей компании, подготовим заказ и организуем доставку по Самаре.'}
    image={T + 'tild6539-6262-4137-b535-666365666436/image.png'}
    buttons={[{ label: 'Обсудить сотрудничество', href: '/corparate#form' }]}
  />
  <CategoryTiles title="Цветы для задач вашей компании" sub="Заказывайте букеты и композиции Milovini для сотрудников, клиентов, партнёров и корпоративных событий. В каталоге доступны:" limit={8} />
  <ListCards
    title="Для каких задач заказывают цветы"
    text="Подберём цветы под задачу вашей компании, подготовим заказ и организуем доставку по Самаре. Milovini принимает и доставляет заказы круглосуточно."
    items={[
      { title: 'Поздравить сотрудников', text: 'Цветы к личным и праздничным датам.', image: T + 'tild6639-3939-4234-b061-343330346230/Rectangle_30782.png' },
      { title: 'Поздравить клиентов и партнёров', text: 'Букеты и композиции для деловых поздравлений.', image: T + 'tild3465-6134-4036-a436-393765623761/Rectangle_30783.png' },
      { title: 'Подготовить заказ к празднику', text: 'Цветы для корпоративных поздравлений к календарным и сезонным датам.', image: T + 'tild3565-6531-4530-b037-303437653664/Rectangle_30784.png' },
      { title: 'Организовать несколько доставок', text: 'Если нужно подготовить цветы для нескольких получателей, обсудим заказ и доставку заранее.', image: T + 'tild3134-6662-4763-b431-363565303966/Rectangle_30785.png' },
    ]}
  />
  <Steps
    title="Как проходит заказ"
    sub="Milovini принимает и доставляет заказы круглосуточно. Перед отправкой пришлём фото готового букета или композиции на согласование."
    items={[
      { icon: T + 'tild6365-3439-4132-b065-343561336631/Group_1171274944.svg', title: 'Расскажите, что нужно', text: 'Укажите количество получателей, повод, дату и пожелания к цветам.' },
      { icon: T + 'tild3562-3238-4063-b730-386437656663/Group_1171274944.svg', title: 'Подберём подходящие варианты', text: 'Поможем выбрать букеты или композиции под задачу и бюджет.' },
      { icon: T + 'tild3965-3631-4335-a133-316364343666/Group_1171274945.svg', title: 'Подготовим заказ', text: 'Флористы Milovini соберут цветы к согласованной дате.' },
      { icon: T + 'tild3566-3930-4565-a164-353034393965/Group_1171274946.svg', title: 'Покажем готовый заказ', text: 'Перед отправкой пришлём фото на согласование.' },
      { icon: T + 'tild3766-3835-4166-b937-383438613837/Group_1171274947.svg', title: 'Организуем доставку', text: 'Доставим заказы по указанным адресам в Самаре.' },
    ]}
  />
  <FeatureList
    title={'Всё необходимое\nдля заказа в одном месте'}
    image={T + 'tild3737-6564-4264-b333-326136366430/Rectangle_30794.png'}
    items={[
      { icon: T + 'tild3764-6435-4135-a139-636432353061/Group_1171274945.svg', title: 'Профессиональные флористы', text: 'С цветами работают флористы Milovini.' },
      { icon: T + 'tild3966-3362-4134-b066-616634323062/Group_1171274946.svg', title: 'Фото перед доставкой', text: 'До отправки можно увидеть готовый заказ.' },
      { icon: T + 'tild6437-3339-4231-b266-356430616163/Group_1171274947.svg', title: 'Доставка 24/7', text: 'Milovini принимает и доставляет заказы круглосуточно.' },
      { icon: T + 'tild3263-3563-4238-b964-633730613935/Group_1171274948.svg', title: 'Разные форматы цветов', text: 'Можно заказать букеты, монобукеты, авторские работы, композиции и корзины.' },
      { icon: T + 'tild3461-3532-4139-b730-363763346462/Group_1171274949.svg', title: 'Дополнения к заказу', text: 'К цветам можно добавить дополнительные товары из ассортимента Milovini – мягкие игрушки, открытки и воздушные шары.' },
    ]}
  />
  <PinkCta
    title="Для компаний, которые заказывают цветы регулярно"
    text={'Milovini уже работает с организациями по действующим договорённостям и заинтересована в развитии корпоративного направления.\nЕсли вашей компании регулярно нужны цветы для сотрудников, клиентов, партнёров или мероприятий, оставьте заявку. Обсудим ваши задачи и формат дальнейшего сотрудничества.'}
    image={T + 'tild3161-3865-4664-a433-653833363437/image_40.png'}
    buttons={[{ label: 'Оставить заявку', href: '/corparate#form' }, { label: 'Выбрать букет', href: '/catalog' }]}
  />
  <Split
    title="Подготовьте цветы заранее"
    image={T + 'tild3235-3634-4731-b464-333266383164/Mask_group.png'}
    html={`<p>Для корпоративных заказов особенно важно заранее определить:</p><ul><li>количество получателей;</li><li>дату;</li><li>формат цветов;</li><li>бюджет;</li><li>адреса доставки.</li></ul><p>Заказы к 8 Марта, 1 сентября и другим календарным датам лучше обсудить заранее – подготовим их к нужному дню.</p>`}
    buttons={[{ label: 'Оставить заявку', href: '/corparate#form' }, { label: 'Помогите выбрать', lead: true }]}
  />
  <section class="section container" id="form">
    <CorpForm client:visible image={img(T + 'tild6435-6665-4666-a363-656231323634/image_41.png')} />
  </section>
  <Reviews id="reviews" />
  <Faq items={faq.corparate} />
  <FinalCta />
  <ContactCard />
</Base>
