---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import IconCards from '../components/IconCards.astro';
import PinkCta from '../components/PinkCta.astro';
import Split from '../components/Split.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import ContactCard from '../components/ContactCard.astro';
import faq from '../data/faq.json';
const T = 'https://static.tildacdn.com/';
---
<Base title="Гарантия качества цветов 48 часов – Milovini Flowers" description="На весь ассортимент Milovini действует гарантия качества 48 часов с момента доставки. Фото перед отправкой, фирменные сумки для перевозки, средство для стойкости цветов.">
  <PageHero
    crumbs={[{ label: 'Главная', href: '/' }, { label: 'Гарантии' }]}
    title="Гарантия качества цветов Milovini – 48 часов"
    text="На весь ассортимент Milovini действует гарантия качества 48 часов с момента доставки. Мы уделяем внимание не только тому, как выглядит букет при сборке, но и каждому этапу до его передачи получателю."
    image={T + 'tild3639-3830-4337-b764-353535613039/image.png'}
    buttons={[{ label: 'Выбрать букет', href: '/catalog' }, { label: 'Помогите выбрать', lead: true }]}
    features={['guarantee', 'delivery', 'bonus', 'allday']}
  />
  <PhotoStrip
    title="Отвечаем за качество цветов"
    sub="Букеты и композиции Milovini, которые мы собрали для наших клиентов"
    images={[
      T + 'tild3336-3162-4434-b533-666539646435/_2026-08-27_12463021.png', T + 'tild3262-6165-4332-b530-623637376237/_2026-08-27_12465311.png',
      T + 'tild3431-6262-4264-b430-613631366261/_2026-08-27_12470517.png', T + 'tild3436-6637-4730-b666-333631666238/_2026-08-27_12471868.png',
      T + 'tild6237-3064-4764-b639-376562376230/_2026-08-27_12473229.png', T + 'tild3461-6638-4236-b835-643235636535/_2026-08-27_12474733.png',
    ]}
  />
  <IconCards
    title="От цветов до готового букета"
    sub="Для Milovini важно, чтобы заказ радовал не только в момент вручения. Поэтому на букеты, композиции и другой цветочный ассортимент действует гарантия качества 48 часов с момента доставки."
    items={[
      { title: 'Прямые закупки цветов', text: 'Работаем с цветами с плантаций Эквадора и Голландии.', image: T + 'tild3234-3666-4865-b435-653130633966/Rectangle_30779.png' },
      { title: 'Опытные флористы', text: 'С каждым заказом работают флористы Milovini, которые собирают букеты и композиции перед отправкой получателю.', image: T + 'tild6635-6662-4430-a334-363935383433/Rectangle_30779.png' },
      { title: 'Фото перед доставкой', text: 'До отправки присылаем фотографию готового заказа на согласование. Вы заранее видите, какой букет или композиция будут доставлены.', image: T + 'tild3235-3462-4632-b637-646233393138/Rectangle_30779.png' },
      { title: 'Бережная перевозка', text: 'Для доставки используем фирменные транспортировочные сумки, которые помогают сохранить внешний вид цветов во время перевозки.', image: T + 'tild3133-6330-4264-b935-633638363835/Rectangle_30779.png' },
    ]}
  />
  <PinkCta
    title="Помогаем сохранить свежесть цветов дольше"
    text="К заказу прикладываем рекомендации по уходу за цветами и средство для увеличения их стойкости. Соблюдение рекомендаций по уходу помогает дольше сохранить внешний вид букета после доставки."
    image={T + 'tild6465-3838-4139-b166-353934376463/image_39.png'}
    buttons={[{ label: 'Выбрать букет', href: '/catalog' }]}
  />
  <Split
    title="Правильный уход начинается сразу после доставки"
    image={T + 'tild3264-6333-4534-a262-363730376433/image.png'}
    html={`<p>После получения цветов важно:</p><ul><li>следовать рекомендациям по уходу, которые мы прикладываем к заказу;</li><li>использовать средство для увеличения стойкости цветов;</li><li>учитывать особенности конкретного букета или композиции.</li></ul><p>Если у вас появились вопросы по состоянию цветов, свяжитесь с Milovini.</p>`}
    social
  />
  <IconCards
    center
    title="Почему можно быть спокойным за заказ"
    items={[
      { icon: T + 'tild6562-3039-4537-a430-323237343931/Group_1171274934.svg', title: 'Гарантия качества 48 часов', text: 'Действует на весь ассортимент с момента доставки.' },
      { icon: T + 'tild6563-3834-4261-b961-646361373732/Group_1171274938.svg', title: 'Фото готового заказа', text: 'Присылаем букет или композицию на согласование перед отправкой.' },
      { icon: T + 'tild3064-6638-4566-a631-383833396232/Group_1171274939.svg', title: 'Бережная доставка', text: 'Перевозим цветы в фирменных транспортировочных сумках.' },
      { icon: T + 'tild6536-3937-4431-b631-356663313938/Group_1171274940.svg', title: 'Рекомендации по уходу', text: 'Прикладываем инструкцию и средство для увеличения стойкости цветов.' },
    ]}
  />
  <Faq items={faq.garantee} />
  <FinalCta />
  <ContactCard />
</Base>
